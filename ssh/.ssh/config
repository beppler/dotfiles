# Read more about SSH config files: https://linux.die.net/man/5/ssh_config

# https://stackoverflow.com/a/38980986/783118 / https://dodwell.us/security/ssh-agent-systemd.html
AddKeysToAgent yes

CheckHostIP no

# https://serverfault.com/questions/29262/how-to-manage-my-ssh-known-hosts-file/29267#29267
HashKnownHosts no

Host beppler.dev.br
    User carlos
    IdentityFile ~/.ssh/id_ed25519_beppler_gmail_com

Host ampere.beppler.dev.br
    User ubuntu
    IdentityFile ~/.ssh/id_ed25519_beppler_gmail_com
    SetEnv TERM=xterm-256color

Host codeberg.org
    AddressFamily inet
    IdentityFile ~/.ssh/id_ed25519_beppler_gmail_com

Host github.com
    IdentityFile ~/.ssh/id_ed25519


Host *
    IgnoreUnknown UseKeychain

    IdentitiesOnly yes
    UseKeychain yes
