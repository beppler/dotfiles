[user]
	email = beppler@gmail.com
	name = Carlos Alberto Costa Beppler
	signingkey = ~/.ssh/id_ed25519_beppler_gmail_com.pub
[commit]
	gpgsign = true
[core]
	fsmonitor = true
[init]
	defaultBranch = main
[fetch]
	prune = true
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers
[push]
	default = simple
[rebase]
	autostash = true
[safe]
	directory = /var/lib/etcgit
[tag]
	gpgsign = true
[http "https://gitlab.celepar.parana/"]
	sslVerify = false
[alias]
	addnw = "!git -c diff.noprefix=false diff -U0 -w --no-color -- \"$@\" | git apply --cached --ignore-whitespace --unidiff-zero #"
	ignore = "!ignore() { curl -L -s https://www.gitignore.io/api/$@ ;}; ignore"
	logs = log --pretty=format:'%C(auto,yellow)%h %C(auto,red)%as %C(auto,blue)%<(20,trunc)%ae%C(auto,green)%d %C(auto,reset)%s' --abbrev=12 --date-order --graph
	lg = logs
	lga = logs --all
	co = checkout
	branches = branch -l --format '%(HEAD) %(if)%(HEAD)%(then)%(color:green)%(end)%(refname:lstrip=2)%(color:reset) [%(color:blue)%(upstream:lstrip=2)%(color:reset)]'
	brs = branches
	delbranch = branch -D
	remotes = remote -v
	st = status
	sw = switch
	tags = "!git for-each-ref --sort=version:refname --format='%(refname:short)|%(creatordate:short)|%(if)%(taggeremail)%(then)%(taggeremail:trim)%(else)-%(end)|%(contents:subject)' refs/tags | column -t -s '|'"
	sync = "!sync() { git pull upstream $(git rev-parse --abbrev-ref HEAD) && git push && git fetch; }; sync"
	untracked = ls-files --others --exclude-standard
	kick = "!kick() { git commit --allow-empty -m 'KICK PIPES'; git push; }; kick"
